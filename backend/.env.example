ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

MAGNIFIC_API_KEY=
# Character sheets and keyframes: gpt-image-2 | seedream (both via Magnific)
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=high
# Music level under narration in the preview mix (0.0-1.0)
BGM_VOLUME=0.2
# Image-to-video via Magnific: kling-v3-pro | kling-v3-std | kling-v3-turbo
VIDEO_MODEL=kling-v3-pro

ELEVENLABS_API_KEY=
# Pick a narrator voice id from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# memory | postgres (docker compose up -d postgres)
CHECKPOINTER=postgres
DATABASE_URL=postgresql://shorts:shorts@localhost:5433/shorts

# local | gcs
STORAGE_BACKEND=local
GCS_BUCKET=

# Optional tracing — leave empty to disable
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
